---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || '个人网站'} />
    <title>{title || 'Your Name'}</title>
    <slot name="head" />
  </head>
  <body class:list={[{ 'wide-layout': wide }]}>
    <Nav />
    <main class:list={[{ 'wide-layout': wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
