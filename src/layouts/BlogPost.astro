---
import Base from './Base.astro';

const { title, date, frontmatter } = Astro.props;
const postTitle = title || frontmatter?.title;
const postDate = date || frontmatter?.date;
---

<Base title={postTitle}>
  <!-- KaTeX stylesheet for math formula rendering -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5"
    crossorigin="anonymous"
    slot="head"
  />
  <article class="blog-post">
    <header>
      <h1>{postTitle}</h1>
      <p class="post-date">{postDate}</p>
    </header>
    <div class="content">
      <slot />
    </div>
    <hr />
    <a href="/blog">← 返回博客</a>
  </article>
</Base>

<style>
  .blog-post header {
    margin-bottom: 2rem;
  }
  .blog-post h1 {
    margin-bottom: 0.5rem;
  }
  .post-date {
    font-size: 0.85rem;
    color: var(--text-light);
  }
  .content {
    line-height: 1.8;
  }
  .content :global(h2) {
    margin-top: 2.5rem;
  }
</style>
