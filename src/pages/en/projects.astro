---
import Base from '../../layouts/Base.astro';

const projects = [
  {
    name: 'Lingmou System (Lingmou)',
    description: 'A collaborative multi-algorithm detection system for rail transit roof monitoring. Integrates YOLO transient object detection, FastAD industrial anomaly detection, and HRNet geometric pose evaluation across 6 fault types, including large sparks, foreign objects, and structural anomalies. Optimized with TensorRT on NVIDIA Jetson AGX Orin, achieving 96 ms single-frame latency and 10 FPS end-to-end throughput.',
    tags: ['YOLO', 'FastAD', 'HRNet', 'TensorRT', 'Jetson AGX Orin', 'C++/Python'],
    link: '/blog/pantograph-algorithm-intro-lingmou',
    github: 'https://github.com/jingfrank/PantoVision.git',
  },
  {
    name: 'Zhimou System (Zhimou)',
    description: 'A secondary semantic verification system based on the multimodal large language model Qwen3-VL 4B. Reviews candidate anomalies output by Lingmou using industrial domain priors. Achieved a 96% false-alarm suppression rate across 10 complex interference scenarios in field tests; deployed on edge devices via vLLM.',
    tags: ['Qwen3-VL', 'vLLM', 'Multimodal LLM', 'Secondary Verification', 'False Alarm Suppression'],
    link: '/blog/pantograph-algorithm-intro-zhimou',
  },
  {
    name: 'FastAD — Real-Time Visual Anomaly Detection Framework (ICANN 2026)',
    description: 'A lightweight unsupervised anomaly detection framework for structural and logical anomalies. Fits multivariate Gaussian distributions on patch and global feature maps using empirical cumulative distribution functions (ECDF). Model fitting takes seconds; inference computes anomaly scores via Mahalanobis distance in milliseconds. Published at ICANN 2026.',
    tags: ['Unsupervised Learning', 'Anomaly Detection', 'ICANN 2026', 'PyTorch', 'TensorRT FP16'],
    link: '/en/about',
    paper: 'https://doi.org/10.1007/978-3-032-38401-0_22',
    github: 'https://github.com/jingfrank/FastAD.git',
  },
  {
    name: 'Wafer Die Micro-Defect Unsupervised Detection System (AOI)',
    description: 'Microscopic inspection for semiconductor packaging wafer dies, addressing severe class imbalance and cold-start challenges. Achieves 8.0 ms model inference latency and 38.5 ms end-to-end latency (>25 FPS) on RTX 3090, providing anomaly heatmaps for defect localization and closed-loop parameter tuning.',
    tags: ['Semiconductor AOI', 'Anomaly Detection', 'Feature Embedding', 'RTX 3090', 'Heatmap Localization'],
    link: '/en/about#wafer-aoi',
    github: 'https://github.com/jingfrank/OpenCADS.git',
  },
];
---

<Base title="Projects - Frank">
  <h1>Featured Projects & Systems</h1>
  <p>Representative work in industrial computer vision, edge model deployment, and academic research:</p>

  <div class="projects">
    {projects.map((project) => (
      <article class="project-card">
        <div class="project-header">
          <h2>
            <a href={project.link} target={project.link.startsWith('http') ? '_blank' : '_self'}>
              {project.name}
            </a>
          </h2>

          <div class="project-links">
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="action-btn btn-github">
                <svg class="icon-github" viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                <span>GitHub ↗</span>
              </a>
            )}
            {project.paper && (
              <a href={project.paper} target="_blank" rel="noopener noreferrer" class="action-btn btn-paper">
                <span class="btn-icon">📄</span>
                <span>Paper ↗</span>
              </a>
            )}
          </div>
        </div>

        <p class="project-desc">{project.description}</p>
        
        <div class="tags">
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</Base>

<style>
  .projects {
    margin-top: var(--space-xl);
  }
  .project-card {
    padding: var(--card-padding) 0;
    border-bottom: 1px solid var(--border);
  }
  .project-card:last-child {
    border-bottom: none;
  }

  /* 标题与右侧按钮容器 */
  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--header-gap);
    flex-wrap: wrap;
    margin-bottom: var(--element-gap);
  }
  .project-header h2 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.4;
    flex: 1;
    min-width: 260px;
  }
  .project-header h2 a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .project-header h2 a:hover {
    color: var(--accent);
  }

  /* 右侧精简按钮组 */
  .project-links {
    display: flex;
    gap: var(--element-gap);
    align-items: center;
    flex-shrink: 0;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.8rem;
    font-weight: 500;
    padding: var(--space-xs) var(--element-gap);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid var(--border);
    background: var(--code-bg);
    color: var(--text);
    white-space: nowrap;
    line-height: 1.3;
  }

  .action-btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  /* GitHub 按钮 */
  .btn-github {
    border-color: #24292f33;
    font-weight: 600;
  }
  .btn-github:hover {
    border-color: var(--text);
    color: var(--text);
  }
  .icon-github {
    display: inline-block;
    vertical-align: middle;
  }

  /* Paper 按钮 */
  .btn-paper {
    border-color: var(--border);
  }
  .btn-paper:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  /* 描述与标签 */
  .project-desc {
    color: var(--text);
    font-size: 0.94rem;
    line-height: 1.65;
    margin-bottom: var(--header-gap);
  }
  .tags {
    display: flex;
    gap: var(--element-gap);
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.15rem var(--element-gap);
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-light);
  }
</style>