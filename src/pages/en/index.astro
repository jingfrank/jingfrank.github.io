---
import Base from '../../layouts/Base.astro';

// Recent selected articles
const recentPosts = [
  {
    title: 'Lingmou System',
    slug: 'pantograph-algorithm-intro-lingmou',
    date: '2026-11-04',
    desc: 'Combines YOLO object detection, FastAD anomaly detection, and HRNet pose estimation for fast response and low missed-detection rates under dynamic train operations.',
  },
  {
    title: 'Zhimou System',
    slug: 'pantograph-algorithm-intro-zhimou',
    date: '2026-11-04',
    desc: 'Deploys multimodal models via on-device vLLM to review candidate anomalies using domain priors, reducing false alarms in industrial field environments.',
  },
  {
    title: 'Multi-Model TensorRT Acceleration on NVIDIA Jetson Orin',
    slug: 'pantograph-detection-tensorrt-acceleration',
    date: '2026-10-08',
    desc: 'Resolves serial multi-model bottlenecks under a 60W power budget, achieving 10.35x speedup via model pruning to meet a 33.3 ms hard real-time latency budget.',
  },
];

// Highlight cards (4 items in 2x2 layout)
const highlights = [
  {
    title: 'Lingmou System (Lingmou)',
    badge: 'Edge Monitoring · Real-Time Front-End',
    desc: 'Combines YOLO object detection, FastAD anomaly detection, and HRNet pose estimation. Optimized with TensorRT on Jetson AGX Orin to reach 10 FPS real-time monitoring.',
    link: '/en/projects',
    isExternal: false,
  },
  {
    title: 'Zhimou System (Zhimou)',
    badge: 'On-Device Multimodal · Secondary Verification',
    desc: 'Integrates multimodal model Qwen3-VL 4B deployed with vLLM to review anomaly candidates using visual-linguistic priors, reaching a 96% false-alarm suppression rate in tests.',
    link: '/en/projects',
    isExternal: false,
  },
  {
    title: 'FastAD Visual Anomaly Detection Framework',
    badge: 'ICANN 2026 · Research Paper',
    desc: 'Lightweight unsupervised anomaly detection framework. Fits multivariate Gaussian distributions on patch and global feature maps using empirical CDFs. Training takes seconds; inference runs in milliseconds via Mahalanobis distance. Published at ICANN 2026.',
    link: '/en/projects',
    isExternal: false,
  },
  {
    title: 'Wafer Die Micro-Defect Unsupervised Detection',
    badge: 'Semiconductor Packaging · AOI Inspection',
    desc: 'Detects die micro-defects using normal sample feature embeddings for cold start. Achieves 8 ms single-model inference on RTX 3090, supporting anomaly heatmaps for defect attribution.',
    link: 'https://github.com/jingfrank/OpenCADS.git',
    isExternal: true,
  },
];
---

<Base title="Frank - Homepage">
  <section class="hero">
    <h1>Hi, I'm Frank 👋</h1>
    <p class="hero-intro">
      I am an algorithm engineer and researcher focusing on <strong>computer vision, industrial anomaly detection, and real-time edge deployment</strong>.
    </p>
    <p class="hero-desc">
      Working on unsupervised learning, lightweight vision models, and on-device multimodal LLMs, deployed on <strong>NVIDIA Jetson / TensorRT / vLLM</strong> platforms for low-latency, hard real-time industrial applications.
    </p>
    <div class="hero-links">
      <a href="/en/about" class="btn btn-primary">About Me →</a>
      <a href="/en/blog" class="btn btn-outline">Blog</a>
      <a href="/en/projects" class="btn btn-outline">Projects</a>
      <a href="https://github.com/jingfrank" target="_blank" rel="noopener" class="btn btn-outline">GitHub ↗</a>
    </div>
  </section>

  <section class="section">
    <h2>🌟 Key Systems & Research</h2>
    <div class="highlight-grid">
      {highlights.map((item) => (
        <a href={item.link} target={item.isExternal ? '_blank' : '_self'} rel="noopener" class="highlight-card">
          <div class="card-top">
            <span class="badge">{item.badge}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>📝 Recent Articles</h2>
      <a href="/en/blog" class="more-link">View all articles →</a>
    </div>
    <ul class="post-list">
      {recentPosts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.slug}`} class="post-link">
            <div class="post-info">
              <span class="post-title">{post.title}</span>
              <p class="post-desc">{post.desc}</p>
            </div>
            <span class="post-date">{post.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* Hero 区域 */
  .hero {
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .hero h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-base);
    letter-spacing: -0.02em;
  }

  .hero-intro {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: var(--header-gap);
  }

  .hero-desc {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-light);
    margin-bottom: var(--card-padding);
  }

  .hero-links {
    display: flex;
    gap: var(--header-gap);
    flex-wrap: wrap;
    margin-top: var(--space-base);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem var(--space-base);
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--text);
    color: var(--bg);
    border: 1px solid var(--text);
  }

  .btn-primary:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  .btn-outline {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-outline:hover {
    background: var(--bg-hover);
    border-color: var(--text-light);
    text-decoration: none;
  }

  /* 成果卡片 */
  .section {
    margin-top: var(--section-gap);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-base);
  }

  .section-header h2 {
    margin: 0;
  }

  .more-link {
    font-size: 0.88rem;
    color: var(--accent);
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--card-gap);
    margin-top: var(--space-base);
  }

  @media (max-width: 600px) {
    .highlight-grid {
      grid-template-columns: 1fr;
    }
  }

  .highlight-card {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: var(--card-padding);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .highlight-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(0, 112, 243, 0.1);
    text-decoration: none;
  }

  .card-top {
    margin-bottom: var(--element-gap);
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    padding: 0.2rem var(--element-gap);
    border-radius: 4px;
    background: rgba(0, 112, 243, 0.1);
    color: var(--accent);
    font-weight: 500;
    line-height: 1.2;
  }

  .highlight-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0.35rem 0 var(--element-gap);
    line-height: 1.3;
  }

  .highlight-card p {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  /* 文章列表 */
  .post-list {
    list-style: none;
    margin-left: 0;
    margin-top: var(--space-base);
  }

  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--space-base) 0;
    text-decoration: none;
    color: inherit;
    gap: var(--card-gap);
    transition: color 0.15s;
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }

  .post-info {
    flex: 1;
    min-width: 0;
  }

  .post-title {
    font-weight: 600;
    font-size: 0.98rem;
    display: block;
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .post-desc {
    font-size: 0.84rem;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0;
  }

  .post-date {
    font-size: 0.82rem;
    color: var(--text-light);
    white-space: nowrap;
    margin-top: 0.1rem;
    font-variant-numeric: tabular-nums;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
</style>