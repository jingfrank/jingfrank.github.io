---
import Base from '../../../layouts/Base.astro';

// Blog post list
const posts = [
  {
    slug: 'pantograph-algorithm-intro-lingmou',
    title: 'Lingmou System',
    date: '2026-11-04',
    tag: 'Industrial Vision / Object Detection / Pose Estimation / Anomaly Detection',
  },
  {
    slug: 'pantograph-algorithm-intro-zhimou',
    title: 'Zhimou System',
    date: '2026-11-04',
    tag: 'Multimodal LLM / Scene Understanding / Secondary Verification / Qwen3-VL',
  },
  {
    slug: 'pantograph-detection-tensorrt-acceleration',
    title: 'Multi-Model TensorRT Acceleration on NVIDIA Jetson Orin',
    date: '2026-10-08',
    tag: 'Jetson Orin / TensorRT / Model Pruning / Scheduling',
  },
  {
    slug: 'edge-hardware-video-encoding',
    title: 'Hardware Video Encoding on NVIDIA Jetson Orin',
    date: '2026-09-28',
    tag: 'Edge Computing / Video Engineering',
  },
  {
    slug: 'vllm-inference-acceleration-benchmark',
    title: 'Qwen3-VL-4B vLLM Inference Benchmark & Acceleration on Jetson AGX Orin',
    date: '2026-08-27',
    tag: 'Inference Acceleration / vLLM',
  },
];
---

<Base title="Blog - Frank Jing">
  <h1>Blog</h1>
  <p>Notes on multimodal LLM deployment, high-performance inference acceleration, and edge computing.</p>

  <div class="posts blog-list">
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-main">
          <a href={`/en/blog/${post.slug}`} class="post-title-link">
            <h2>{post.title}</h2>
          </a>
          <time class="post-date post-date--desktop" datetime={post.date}>{post.date}</time>
        </div>
        {(post.date || post.tag) && (
          <p class="post-meta">
            <span class="post-date post-date--mobile">
              <time datetime={post.date}>{post.date}</time>
              {post.tag && <span class="meta-sep" aria-hidden="true"> · </span>}
            </span>
            {post.tag && <span class="post-tags">{post.tag.replace(/\s*\/\s*/g, ' · ')}</span>}
          </p>
        )}
      </article>
    ))}
  </div>
</Base>

<style>
  .posts {
    margin-top: var(--space-xl);
  }
  .post-card {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .post-card:last-child {
    border-bottom: none;
  }
  .post-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-base);
  }
  .post-title-link {
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }
  .post-title-link h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }
  .post-title-link:hover h2 {
    color: var(--accent);
  }
  .post-date {
    font-size: 0.82rem;
    color: var(--text-light);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .post-meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.5;
  }
  .post-date--mobile {
    display: none;
  }
  .meta-sep {
    margin: 0 0.1rem;
  }
  .post-tags {
    color: var(--text-light);
  }

  @media (max-width: 640px) {
    .post-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
    .post-date--desktop {
      display: none;
    }
    .post-date--mobile {
      display: inline;
      font-variant-numeric: tabular-nums;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
  }
</style>