---
import Base from '../../layouts/Base.astro';
---

<Base title="Contact - Frank">
  <h1>Contact</h1>
  <p>If you are interested in industrial visual anomaly detection, edge deployment (TensorRT / vLLM), or research collaboration, feel free to reach out:</p>

  <div class="contact-list">
    <a href="mailto:1150634497@qq.com" class="contact-item">
      <span class="contact-icon">✉️</span>
      <div>
        <h3>Email</h3>
        <p>1150634497@qq.com</p>
      </div>
    </a>
    <a href="https://github.com/jingfrank" target="_blank" rel="noopener" class="contact-item">
      <span class="contact-icon">💻</span>
      <div>
        <h3>GitHub</h3>
        <p>@jingfrank</p>
      </div>
    </a>
    <a href="https://doi.org/10.1007/978-3-032-38401-0_22" target="_blank" rel="noopener" class="contact-item">
      <span class="contact-icon">📄</span>
      <div>
        <h3>Academic Paper (ICANN 2026)</h3>
        <p>FastAD: A Deployable Framework for Real Time Visual Anomaly Detection</p>
      </div>
    </a>
  </div>
</Base>

<style>
  .contact-list {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--card-gap);
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--card-gap);
    padding: var(--card-gap) var(--card-padding);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .contact-item:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(0, 112, 243, 0.1);
    text-decoration: none;
  }
  .contact-icon {
    font-size: 1.5rem;
  }
  .contact-item h3 {
    margin: 0;
    font-size: 1rem;
  }
  .contact-item p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-light);
  }
</style>