---
import Base from '../../layouts/Base.astro';

// 博客文章列表
const posts = [
  {
    slug: 'pantograph-system-project-retrospective',
    title: '【重磅复盘】动车组“弓网智能分析系统”：从零到规模商用的全周期架构演进与落地复盘',
    date: '2026-09-09',
    tag: '项目复盘 / 旗舰 / 工业AI',
    description: '跳出局部实操视角，全面对标苏州华启智能（HQ-TSW-PIA-01A）商用产品规范！系统复盘动车组弓网智能分析系统从立项选型、车载物理拓扑、华启 5 大故障检测与业务防御闭环，到四代算法演进（YOLO ➔ VLM ➔ 两阶段 ➔ FastAD+状态机+VLM 异构协同）、三大工程战役攻坚、量化收益矩阵与失败教训方法论。',
  },
  {
    slug: 'pantograph-geometric-tilt-detection-hrnet',
    title: '【实战】受电弓姿态倾斜监测：从 HRNet 刚性关键点解耦到局部基准系抗误报全景',
    date: '2026-09-09',
    tag: '工业视觉 / 姿态解算 / 抗虚警',
    description: '高铁动车组受电弓 2D 倾斜监测实战：为什么从 10 关键点精简为 4 刚性铰点以避开碳滑板磨耗干扰？为什么直接求绝对角平均会导致 50%+ 虚警？如何基于下横梁局部浮动坐标系构建 SO(2) 刚体旋转不变量，将虚警率降至 3.3% 并精准捕获真实结构扭折？附 120 秒高清视频全量评测与工程级代码。',
  },
  {
    slug: 'jetson-hardware-commands-and-rtsp-guide',
    title: '【实战】Jetson 硬件底座特有查询指令与 EasyDarwin RTSP 推拉流联调踩坑全景',
    date: '2026-09-08',
    tag: '边缘工程 / 流媒体实战',
    description: '系统梳理 Jetson 原厂硬件诊断与调优指令全家桶（nv_tegra_release、tegrastats、nvpmodel、jetson_clocks），并完整复盘 Windows EasyDarwin 7.2 与 Jetson Docker 推拉流联调中 30s 超时、OpenCV 段错误、时间戳回绕断流、时钟时区与花屏等五大核心避坑总结。',
  },
  {
    slug: 'fastad-industrial-anomaly-detection-decoupling',
    title: '【系列四】从无监督热力图到确定性诊断：FastAD 工业异常检测与空间-时序解耦状态机实战',
    date: '2026-09-04',
    tag: '工业视觉 / 异常检测',
    description: '深度解析如何利用仅需纯正常样本训练的 FastAD 算法实现单帧 45ms 车载极速筛查，以及如何通过自研的 PantographFaultClassifier 空间-时序解耦状态机（ROI 隔离、大火花物理熔断、64×64 相机系时序网格与 dirt_pending 观察态），填补从无监督热力图到确定性故障分类的语义鸿沟。',
  },
  {
    slug: 'vllm-inference-acceleration-benchmark',
    title: '【系列三】从 5.5s 到 1.06s：基于 vLLM 与推测并发的高性能推理优化实战',
    date: '2026-08-27',
    tag: '推理加速 / vLLM',
    description: '深入复盘如何利用 Docker 容器化微服务、vLLM PagedAttention、连续批处理与推测多线程并发架构，将端到端滑动窗口诊断时延从 5,500ms 压缩至 1,068ms（提速近 4 倍），并解决 C/C++ 堆损坏排错全过程。',
  },
  {
    slug: 'pantograph-vlm-twostage-algorithm',
    title: '【系列二】动静分离两阶段 VLM 架构与跨窗口时序一致性滤波实战',
