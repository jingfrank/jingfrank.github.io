---
import Base from '../layouts/Base.astro';

const projects = [
  {
    name: '灵眸系统 (Lingmou)',
    description: '面向轨道交通车顶监控的轻量多算法协同检测系统。融合 YOLO 瞬态目标检测、FastAD 工业异常检测与 HRNet 几何姿态评估，覆盖大火花、异物悬挂、结构异常等 6 类故障。基于 NVIDIA Jetson AGX Orin 完成 TensorRT 深度优化，单帧延迟仅 96ms，端到端吞吐达 10 FPS。',
    tags: ['YOLO', 'FastAD', 'HRNet', 'TensorRT', 'Jetson AGX Orin', 'C++/Python'],
    link: '/blog/pantograph-algorithm-intro-lingmou',
    github: 'https://github.com/jingfrank/PantoVision.git',
  },
  {
    name: '智眸系统 (Zhimou)',
    description: '基于多模态大语言模型（Qwen3-VL 4B）的二次语义审查系统。针对灵眸前置输出的候选异常，结合工业场景先验做“专家式”复核，在包含 10 类复杂干扰的多工况实测中实现高达 96% 的误报抑制率，基于 vLLM 实现边缘端高效推理。',
    tags: ['Qwen3-VL', 'vLLM', '多模态大模型', '二次研判', '误报抑制'],
    link: '/blog/pantograph-algorithm-intro-zhimou',
  },
  {
    name: 'FastAD — 实时工业视觉异常检测框架 (ICANN 2026)',
    description: '轻量无监督异常检测框架，可同时检测结构异常与逻辑异常。通过对局部图块与全局特征图的逐通道经验累积分布构建描述子并拟合多元高斯分布，训练过程仅需数秒；推理时通过马氏距离计算异常分数，检测仅需毫秒级，已收录于 ICANN 2026。',
    tags: ['无监督学习', '异常检测', 'ICANN 2026', 'PyTorch', 'TensorRT FP16'],
    link: '/about',
    paper: 'https://doi.org/10.1007/978-3-032-38401-0_22',
    github: 'https://github.com/jingfrank/FastAD.git',
  },
  {
    name: '晶圆芯片微观缺陷无监督检测系统 (AOI)',
    description: '面向半导体封测环节晶圆晶粒（Die）显微质检，解决正负样本极度不平衡与冷启动难题。在 RTX 3090 上实现单模型推理仅 8.0ms、系统端到端延迟 38.5ms（>25 FPS），并提供高精度异常热力图定位与参数闭环微调。',
    tags: ['半导体质检', 'AOI', '特征嵌入', 'RTX 3090', '热力图定位'],
    link: '/about#wafer-aoi',
    github: 'https://github.com/jingfrank/OpenCADS.git',
  },
];
---

<Base title="项目 - Frank">
  <h1>精选项目 & 落地系统</h1>
  <p>工业视觉、边缘端模型加速部署与学术研究代表作：</p>

  <div class="projects">
    {projects.map((project) => (
      <article class="project-card">
        <div class="project-header">
          <h2>
            <a href={project.link} target={project.link.startsWith('http') ? '_blank' : '_self'}>
              {project.name}
            </a>
          </h2>

          <div class="project-links">
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="action-btn btn-github">
                <svg class="icon-github" viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                <span>GitHub ↗</span>
              </a>
            )}
            {project.paper && (
              <a href={project.paper} target="_blank" rel="noopener noreferrer" class="action-btn btn-paper">
                <span class="btn-icon">📄</span>
                <span>Paper ↗</span>
              </a>
            )}
          </div>
        </div>

        <p class="project-desc">{project.description}</p>
        
        <div class="tags">
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</Base>

<style>
  .projects {
    margin-top: var(--space-xl);
  }
  .project-card {
    padding: var(--card-padding) 0;
    border-bottom: 1px solid var(--border);
  }
  .project-card:last-child {
    border-bottom: none;
  }

  /* 标题与右侧按钮容器 */
  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--header-gap);
    flex-wrap: wrap;
    margin-bottom: var(--element-gap);
  }
  .project-header h2 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.4;
    flex: 1;
    min-width: 260px;
  }
  .project-header h2 a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .project-header h2 a:hover {
    color: var(--accent);
  }

  /* 右侧精简按钮组 */
  .project-links {
    display: flex;
    gap: var(--element-gap);
    align-items: center;
    flex-shrink: 0;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.8rem;
    font-weight: 500;
    padding: var(--space-xs) var(--element-gap);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid var(--border);
    background: var(--code-bg);
    color: var(--text);
    white-space: nowrap;
    line-height: 1.3;
  }

  .action-btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  /* GitHub 按钮 */
  .btn-github {
    border-color: #24292f33;
    font-weight: 600;
  }
  .btn-github:hover {
    border-color: var(--text);
    color: var(--text);
  }
  .icon-github {
    display: inline-block;
    vertical-align: middle;
  }

  /* Paper 按钮 */
  .btn-paper {
    border-color: var(--border);
  }
  .btn-paper:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  /* 描述与标签 */
  .project-desc {
    color: var(--text);
    font-size: 0.94rem;
    line-height: 1.65;
    margin-bottom: var(--header-gap);
  }
  .tags {
    display: flex;
    gap: var(--element-gap);
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.15rem var(--element-gap);
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-light);
  }
</style>
